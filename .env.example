# Care4u / HealthFlow — environment contract
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.
#
# Every microservice reads the same variable names; docker-compose.yml injects
# the per-service value (each service gets its own database and port).

# ---------------------------------------------------------------------------
# Shared infrastructure (compose services: db / redis / nats)
# ---------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=healthflow

# ---------------------------------------------------------------------------
# Common per-service settings
# ---------------------------------------------------------------------------
# auth :8080 | booking :8081 | payment :8082 | location :8083
# notifications :8084 | provider :8085
PORT=8080

# One database per stateful service: auth_db, booking_db, payment_db,
# provider_db (location_db is created by init-db.sh but the location service
# uses Redis). Inside compose the host is `db`; a host-run service uses
# 127.0.0.1 (dev.sh exports these).
DATABASE_URL=postgres://user:change-me@127.0.0.1:5432/auth_db?sslmode=disable

NATS_URL=nats://127.0.0.1:4222

# host:port only — passed straight to the Redis client as the address.
REDIS_URL=127.0.0.1:6379

# ---------------------------------------------------------------------------
# auth — OTP login, signs the JWT
# ---------------------------------------------------------------------------
# MUST be overridden in any shared/production environment: the built-in default
# ("super-secret-key") signs tokens that anyone can forge.
JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# payment — Razorpay orders + webhooks
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace-me
# Signs inbound webhooks (X-Razorpay-Signature = HMAC-SHA256 of the raw body).
# When set, /payments/webhook rejects unsigned or tampered payloads with 401.
# When empty the endpoint keeps its local/mock behaviour and logs a warning.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# notifications — Firebase Cloud Messaging
# ---------------------------------------------------------------------------
# Service-account JSON; empty = mock delivery (logged, not sent).
FCM_CREDENTIALS=

# ---------------------------------------------------------------------------
# ci/upload_to_hf.py — Hugging Face CDN publisher used by the Jenkins pipeline
# ---------------------------------------------------------------------------
HF_TOKEN=
